RewriteEngine On

# Redirect legacy Technopark and deprecated instruction URLs to the new Techpark routes.
RewriteRule ^technopark/instructions/?$ /techpark/boot-camp [R=301,L]
RewriteRule ^technopark/boot-camp/?$ /techpark/boot-camp [R=301,L]
RewriteRule ^technopark/membership/?$ /techpark/membership [R=301,L]
RewriteRule ^technopark/sign-in/?$ /techpark/sign-in [R=301,L]
RewriteRule ^technopark/?$ /techpark [R=301,L]
RewriteRule ^techpark/instructions/?$ /techpark/boot-camp [R=301,L]
RewriteRule ^techpark/line-follower-hackathon/?$ /techpark/line-follower-hackathone [R=301,L]

# Prevent rewrite loops once the request is already inside /dist.
RewriteRule ^dist/ - [L]

# The redeploy script runs from the site root, outside dist/.
RewriteRule ^redeploy\.php$ - [L]

# Hideya's Laravel API is deployed in dist/hideya/endpoints; hand every
# /hideya/endpoints URL to it so its own .htaccess routes into public/.
RewriteRule ^hideya/endpoints(/.*)?$ dist/hideya/endpoints$1 [L]

# Hideya's website: the hideya-web repo is cloned in dist/hideya/web and its
# committed build in dist/ is served as /hideya. The slash keeps its relative
# asset URLs inside /hideya/.
RewriteRule ^hideya$ /hideya/ [R=301,L]
RewriteRule ^hideya/redeploy\.php$ dist/hideya/web/redeploy.php [L]
RewriteRule ^hideya/(.*)$ dist/hideya/web/dist/$1 [L]

# Helem Nejse offer: the helem-nejse repo is cloned in dist/helem-nejse/web and
# its committed build in dist/ is served as /helem-nejse. Its own .htaccess
# sends app routes (/helem-nejse/igra/...) to its index.html.
RewriteRule ^helem-nejse$ /helem-nejse/ [R=301,L]
RewriteRule ^helem-nejse/redeploy\.php$ dist/helem-nejse/web/redeploy.php [L]
RewriteRule ^helem-nejse/(.*)$ dist/helem-nejse/web/dist/$1 [L]

# Always serve the built entry file instead of the Vite source index.html.
RewriteRule ^index\.html$ dist/index.html [L]

# Root domain should open the built app.
RewriteRule ^$ dist/index.html [L]

# Serve prerendered Techpark route entry files so crawlers get route-specific metadata.
RewriteRule ^techpark/?$ dist/techpark/index.html [L]
RewriteRule ^techpark/(boot-camp|membership|line-follower-hackathone|sign-in)/?$ dist/techpark/$1/index.html [L]

# If the requested path exists inside /dist, serve that built file or directory.
RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f [OR]
RewriteCond %{DOCUMENT_ROOT}/dist/$1 -d
RewriteRule ^(.+)$ dist/$1 [L]

# SPA fallback for client-side routes such as /techpark and nested pages.
RewriteRule ^ dist/index.html [L]
